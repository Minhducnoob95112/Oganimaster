@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Oganimaster.Models.TDanhMucSp>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Danh mục các sản phẩm</h4>
            
            <!-- Hiển thị thông báo xóa thành công hoặc thất bại từ TempData -->
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["Message"]
                </div>
            }

            <p>
                <a asp-action="ThemSanPhamMoi" class="btn btn-gradient-primary btn-sm mb-3">+ Thêm sản phẩm mới</a>
            </p>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr class="table-warning">
                            <th>Tên sản phẩm</th>
                            <th>Cân nặng</th>
                            <th>Bảo hành</th>
                            <th>Chiết khấu</th>
                            <th>Giá nhỏ nhất</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int count = 0;
                        }
                        @foreach (var item in Model)
                        {
                            count++;
                            string rowClass = (count % 2 == 0) ? "table-info" : "table-success";

                            <tr class="@rowClass">
                                <td>@item.TenSp</td>
                                <td>@(item.CanNang.HasValue ? item.CanNang.Value + " kg" : "-")</td>
                                <td>@(item.ThoiGianBaoHanh.HasValue ? item.ThoiGianBaoHanh.Value + " tháng" : "-")</td>
                                <td>@(item.ChietKhau.HasValue ? item.ChietKhau.Value + "%" : "0%")</td>
                                <td>@(item.GiaNhoNhat.HasValue ? item.GiaNhoNhat.Value.ToString("#,##0") + " VNĐ" : "-")</td>
                                <td>
                                    <a asp-action="SuaSanPham" asp-route-maSanPham="@item.MaSp?.Trim()" class="btn btn-warning btn-xs">Sửa</a> |
                                    <a asp-action="XoaSanPham" asp-route-maSanPham="@item.MaSp?.Trim()" 
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');" 
                                       class="btn btn-danger btn-xs">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            <div class="product__pagination text-center mt-4 d-flex justify-content-center">
                @Html.PagedListPager(Model, page => Url.Action("DanhMucSanPham", new { page = page }))
            </div>
        </div>
    </div>
</div>