@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Oganimaster.Models.TDanhMucSp>

@{
    ViewData["Title"] = "Sản phẩm theo loại";
    Layout = "~/Views/Shared/_LayoutOgani.cshtml";
}

<section class="featured spad" style="padding-top: 40px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Sản phẩm theo loại</h2>
                </div>
            </div>
        </div>

        <div class="row featured__filter">
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    @await Html.PartialAsync("_PartialSanPham", item)
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p>Không có sản phẩm nào thuộc loại này.</p>
                </div>
            }
        </div>

        <!-- Thanh phân trang: giữ lại tham số maloai và page -->
        <div class="product__pagination text-center mt-4">
            @Html.PagedListPager(Model, page => Url.Action("SanPhamTheoLoai", new { maloai = ViewBag.maloai, page = page }))
        </div>
    </div>
</section>