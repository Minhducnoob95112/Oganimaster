@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<Oganimaster.Models.TDanhMucSp>

@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_LayoutOgani.cshtml";
}

<!-- Section Featured Product -->
<section class="featured spad" style="padding-top: 50px;">
    <div class="container">
        <!-- Khối Tiêu đề + Các tab phân loại chuẩn giống cô (Ảnh 1) -->
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Featured Product</h2>
                </div>
                <div class="featured__controls">
                    <ul>
                        <li class="active" data-filter="*">All</li>
                        <li data-filter=".oranges">Oranges</li>
                        <li data-filter=".fresh-meat">Fresh Meat</li>
                        <li data-filter=".vegetables">Vegetables</li>
                        <li data-filter=".fastfood">Fastfood</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Vùng hiển thị sản phẩm (nơi Ajax đổ dữ liệu vào) -->
        <div class="row featured__filter" id="displayProducts">
            @foreach (var item in Model)
            {
               @await Html.PartialAsync("_PartialSanPham", item)
            }
        </div>

        <!-- Thanh phân trang ở đáy -->
        <div class="product__pagination text-center mt-4">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }))
        </div>
    </div>
</section>