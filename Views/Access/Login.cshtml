@model Oganimaster.Models.TUser

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Purple Admin - Đăng nhập</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/LayoutAdmin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/LayoutAdmin/assets/vendors/css/vendor.bundle.base.css">
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/LayoutAdmin/assets/css/style.css">
    <link rel="shortcut icon" href="~/LayoutAdmin/assets/images/favicon.ico" />
  </head>
  <body>
    <div class="container-scroller">
      <div class="container-fluid page-body-wrapper full-page-wrapper">
        <div class="content-wrapper d-flex align-items-center auth">
          <div class="row flex-grow">
            <div class="col-lg-4 mx-auto">
              <div class="auth-form-light text-left p-5">
                <div class="brand-logo text-center">
                  <img src="~/LayoutAdmin/assets/images/logo.svg" alt="logo">
                </div>
                <h4>Hello! let's get started</h4>
                <h6 class="font-weight-light">Sign in to continue.</h6>

                <form class="pt-3" asp-action="Login" method="post">
                  <div class="form-group mb-3">
                    <input asp-for="Username" class="form-control form-control-lg" placeholder="Username" required />
                  </div>
                  <div class="form-group mb-3">
                    <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Password" required />
                  </div>
                  
                  <!-- Nút đăng nhập hệ thống -->
                  <div class="mt-3">
                    <button type="submit" class="btn btn-block btn-gradient-primary btn-lg font-weight-medium auth-form-btn w-100">
                      SIGN IN
                    </button>
                  </div>

                  <!-- Tùy chọn nhớ mật khẩu & quên mật khẩu -->
                  <div class="my-2 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                      <label class="form-check-label text-muted">
                        <input type="checkbox" class="form-check-input"> Keep me signed in
                      </label>
                    </div>
                    <a href="#" class="auth-link text-black">Forgot password?</a>
                  </div>

                  <!-- Nút kết nối Facebook theo mẫu -->
                  <div class="mb-2">
                    <button type="button" class="btn btn-block btn-facebook auth-form-btn w-100 text-white" style="background-color: #3b579d;">
                      <i class="mdi mdi-facebook me-2"></i>Connect using facebook
                    </button>
                  </div>

                  <!-- Dòng đăng ký tài khoản mới -->
                  <div class="text-center mt-4 font-weight-light">
                    Don't have an account? <a href="#" class="text-primary">Create</a>
                  </div>
                </form>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- plugins:js -->
    <script src="~/LayoutAdmin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~/LayoutAdmin/assets/js/off-canvas.js"></script>
    <script src="~/LayoutAdmin/assets/js/hoverable-collapse.js"></script>
    <script src="~/LayoutAdmin/assets/js/misc.js"></script>
  </body>
</html>